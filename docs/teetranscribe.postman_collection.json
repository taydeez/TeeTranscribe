{
  "info": {
    "_postman_id": "8a874a7c-a8cc-4fb6-b5d5-f3adfb5da6e6",
    "name": "TeeTranscribe API",
    "description": "TeeTranscribe API. Sign in, upload or supply a public audio URL, create a billing quote, poll until ready, then confirm POST /transcribe with quote_id. One credit equals NGN 1. NGN and USD purchases fund the same credit wallet. Use a fresh client_key per distinct request; reuse it only when retrying the same operation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
