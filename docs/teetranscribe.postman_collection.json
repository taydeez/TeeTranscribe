        },
        {
          "name": "Create transcription quote",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/quotes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_key\": \"{{$guid}}\",\n  \"audio_url\": \"{{audioUrl}}\",\n  \"language_code\": \"en\",\n  \"audio_storage_path\": \"{{audioStoragePath}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns a measuring quote and immediately queues media inspection after the transaction commits. Completed uploads owned by this user are probed through a fresh signed R2 URL; remote probing falls back to local inspection when necessary. Pasted URLs keep the verified-download flow. Poll the quote until ready before confirming transcription. The outbox recovers dispatch failures."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const result = pm.response.json(); pm.collectionVariables.set(\"billingQuoteId\", result.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create quote from public audio URL",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/quotes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_key\": \"{{$guid}}\",\n  \"audio_url\": \"https://example.com/interview.mp3\",\n  \"language_code\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns a measuring quote and immediately queues media inspection after the transaction commits. Completed uploads owned by this user are probed through a fresh signed R2 URL; remote probing falls back to local inspection when necessary. Pasted URLs keep the verified-download flow. Poll the quote until ready before confirming transcription. The outbox recovers dispatch failures."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const result = pm.response.json(); pm.collectionVariables.set(\"billingQuoteId\", result.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Check transcription quote",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/quotes/{{billingQuoteId}}"
          }
        },
        {
          "name": "Create purchase quote",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/purchases",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_key\": \"{{$guid}}\",\n  \"package_id\": \"starter\",\n  \"currency\": \"NGN\",\n  \"payment_method\": \"{{paymentMethod}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Choose a payment_method code from the active payment methods endpoint (paystack or flutterwave). Both gateways may be enabled simultaneously. The chosen method is stored on this purchase and cannot change on an idempotent retry. Amounts are minor currency units."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const result = pm.response.json(); pm.collectionVariables.set(\"paymentId\", result.id); }",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"paymentReference\", pm.response.json().reference);"
                ]
              }
            }
          ]
        },
        {
          "name": "Initialize secure checkout",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/purchases/{{paymentId}}/checkout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns the selected gateway’s verified hosted checkout URL. Paystack uses PAYSTACK_CALLBACK_URL from the backend environment for its callback_url; Flutterwave uses FLUTTERWAVE_CALLBACK_URL for redirect_url. Paystack returns reference and Flutterwave returns tx_ref. The frontend /payment/callback route forwards that reference to /dashboard/billing, which verifies the payment with the backend; query-string status is not proof of payment. Verify the payment through the authenticated verification endpoint before treating it as paid. Flutterwave test-mode purchases also accept its checkout-v2.dev-flutterwave.com checkout host; live purchases only accept checkout.flutterwave.com."
          }
        },
        {
          "name": "Verify payment",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/payments/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{paymentReference}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send the stored payment reference, or the callback reference / tx_ref. Verification uses the gateway saved on the payment and credits the wallet once."
          }
        },
        {
          "name": "Payment history",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/history/payments?page=1&per_page=20"
          }
        },
        {
          "name": "Usage history",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/history/usage?page=1&per_page=20"
          }
        },
        {
          "name": "Credit ledger",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/history/ledger?page=1&per_page=20"
          }
        },
        {
          "name": "Paystack webhook",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-paystack-signature",
                "value": "{{paystackSignature}}"
              }
            ],
            "url": "{{baseUrl}}/webhooks/paystack",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.success\",\n  \"data\": {\n    \"reference\": \"{{paymentReference}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Paystack sends this server-to-server. Signature is HMAC SHA512 of the exact raw request body with PAYSTACK_SECRET_KEY. Do not put live secret keys into shared collections. The backend independently verifies amount, currency, reference, customer, and environment."
          }
        },
        {
          "name": "Flutterwave webhook",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "verif-hash",
                "value": "{{flutterwaveWebhookSecretHash}}"
              }
            ],
            "url": "{{baseUrl}}/webhooks/flutterwave",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.completed\",\n  \"data\": {\n    \"tx_ref\": \"{{paymentReference}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Flutterwave v3 sends this server-to-server. Configure FLUTTERWAVE_WEBHOOK_SECRET_HASH and the same secret hash in Flutterwave. The backend independently verifies the stored purchase with Flutterwave before crediting the wallet; duplicate events are idempotent."
          }
        },
        {
          "name": "Download payment invoice",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sanctumToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/billing/payments/{{paymentId}}/invoice",
            "description": "Payment owner only. Returns url and expires_at for a five-minute R2 PDF download. Returns 409 while invoice generation is pending. Payment history includes invoice_ready and invoice_number. Confirmed payments enqueue a PDF invoice and email with attachment; run the scheduler/outbox publisher and default Redis queue worker."
          }
        }
      ]
    }
  ]
}
