{
  "info": {
    "_postman_id": "8a874a7c-a8cc-4fb6-b5d5-f3adfb5da6e6",
    "name": "TeeTranscribe API",
    "description": "Local API requests for TeeTranscribe. Keep this collection in sync whenever an API endpoint is added or changed. Create a guest session first, then use its id for transcription requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "userId", "value": "" },
    { "key": "folderId", "value": "" },
    { "key": "guestSessionId", "value": "" },
    { "key": "transcriptionId", "value": "" },
    { "key": "callbackSignature", "value": "" },
    { "key": "callbackExpires", "value": "" },
    { "key": "sanctumToken", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"your name or Organization name.\",\n  \"email\": \"new-user@example.com\",\n  \"password\": \"password1\",\n  \"password_confirmation\": \"password1\"\n}" }, "url": "{{baseUrl}}/auth/register" }
    },
    {
      "name": "Login",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password\"\n}" }, "url": "{{baseUrl}}/auth/login" }
    },
    {
      "name": "Verify admin email code",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"code\": \"123456\"\n}" }, "url": "{{baseUrl}}/auth/admin/verify" }
    },
    {
      "name": "Google OAuth redirect",
      "request": { "method": "GET", "url": "{{baseUrl}}/auth/google/redirect" }
    },
    {
      "name": "Google OAuth callback",
      "request": { "method": "GET", "url": "{{baseUrl}}/auth/google/callback?code=google-authorization-code" }
    },
    {
      "name": "Logout",
      "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }], "url": "{{baseUrl}}/auth/logout" }
    },
    {
      "name": "Get authenticated admin",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }], "url": "{{baseUrl}}/admin/user" }
    },
    {
      "name": "Get authenticated user",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "url": "{{baseUrl}}/user"
      }
    },
    {
      "name": "Create guest session",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('returns a guest session id', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.collectionVariables.set('guestSessionId', pm.response.json().id);",
            "});"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/guest-sessions"
      }
    },
    {
      "name": "Create upload signature",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"interview.mp3\",\n  \"content_type\": \"audio/mpeg\",\n  \"size\": 1048576\n}"
        },
        "url": "{{baseUrl}}/uploads/presign"
      }
    },
    {
      "name": "Start guest transcription",
      "request": {
        "description": "Creates a pending transcription, queues provider submission, and returns HTTP 202. When file_name is omitted, it is derived from the final URL path segment without the extension. Include audio_storage_path for files uploaded through the presign endpoint so the worker can read R2 without relying on an expiring URL.",
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"audio_url\": \"https://example.r2.cloudflarestorage.com/audio/interview.mp3\",\n  \"audio_storage_path\": \"audio/01M40K8ZE4TGFDWD49FCJ6PRH0.mp3\",\n  \"guest_session_id\": \"{{guestSessionId}}\",\n  \"file_name\": \"interview.mp3\",\n  \"name\": \"Customer interview\",\n  \"folder_name\": \"Research\",\n  \"duration\": 123.456,\n  \"language_code\": \"en\"\n}"
        },
        "url": "{{baseUrl}}/transcribe"
      }
    },
    {
      "name": "Start authenticated transcription",
      "request": {
        "description": "Creates a pending transcription, assigns it to the selected folder or today's automatic folder, queues provider submission, and returns HTTP 202.",
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"audio_url\": \"https://example.r2.cloudflarestorage.com/audio/interview.mp3\",\n  \"audio_storage_path\": \"audio/01M40K8ZE4TGFDWD49FCJ6PRH0.mp3\",\n  \"user_id\": {{userId}},\n  \"folder_id\": null,\n  \"file_name\": \"interview.mp3\",\n  \"name\": \"Customer interview\",\n  \"folder_name\": \"Research\",\n  \"duration\": 123.456,\n  \"language_code\": \"en\"\n}"
        },
        "url": "{{baseUrl}}/transcribe"
      }
    },
    {
      "name": "List folders",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "url": "{{baseUrl}}/folders?search=&sort=created_at&direction=desc&page=1&per_page=10"
      }
    },
    {
      "name": "Create folder",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Interviews\"\n}" },
        "url": "{{baseUrl}}/folders"
      }
    },
    {
      "name": "Get folder",
      "request": {
        "description": "Returns the folder's transcriptions and temporary download links for completed TXT and PDF exports. Deepgram transcripts also include provider, timed segments (start/end seconds, speaker, text, confidence), and audioUrl for playback. R2 playback URLs expire after one hour; reopen the folder to refresh them.",
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "url": "{{baseUrl}}/folders/{{folderId}}"
      }
    },
    {
      "name": "Update folder",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Client interviews\"\n}" },
        "url": "{{baseUrl}}/folders/{{folderId}}"
      }
    },
    {
      "name": "Delete folder",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "url": "{{baseUrl}}/folders/{{folderId}}"
      }
    },
    {
      "name": "Add transcription to folder",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "url": "{{baseUrl}}/folders/{{folderId}}/transcriptions/{{transcriptionId}}"
      }
    },
    {
      "name": "Remove transcription from folder",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "url": "{{baseUrl}}/folders/{{folderId}}/transcriptions/{{transcriptionId}}"
      }
    },
    {
      "name": "Update transcription text",
      "request": {
        "description": "Updates an owned transcript and queues replacement TXT and PDF exports. For timed Deepgram editing, include segments in their original order, each containing text and nullable speaker. Segment count must match the stored transcript; timing and confidence remain unchanged. The server derives transcript from segment text. Plain-text edits clear timed segments to prevent stale alignment.",
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sanctumToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"transcript\": \"Corrected transcription text.\"\n}" },
        "url": "{{baseUrl}}/transcriptions/{{transcriptionId}}"
      }
    },
    {
      "name": "Deepgram completion callback",
      "request": {
        "description": "Validates metadata.request_id against a Deepgram transcription, atomically stores transcript and results.utterances as timed segments, and moves the transcription to processing while PDF and TXT exports are generated. Utterances include start, end, transcript, optional speaker number and confidence. Duplicate callbacks do not overwrite saved edits.",
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"metadata\": { \"request_id\": \"provider-request-id\", \"duration\": 123.456 },\n  \"results\": { \"channels\": [{ \"alternatives\": [{ \"transcript\": \"Example transcription text.\" }] }] }\n}"
        },
        "url": "{{baseUrl}}/webhooks/deepgram/{{transcriptionId}}?expires={{callbackExpires}}&signature={{callbackSignature}}"
      }
    }
  ]
}
