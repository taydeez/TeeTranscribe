APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=teetranscribe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_QUEUE_RETRY_AFTER=960

CACHE_STORE=redis
RATE_LIMITER_STORE=redis

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://127.0.0.1:3000
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TRANSCRIBER_FALLBACK=deepgram
INTRON_API_KEY=
INTRON_API_ENDPOINT=https://infer.voice.intron.io
INTRON_DIARIZATION=true
INTRON_DIARIZATION_MIN_DURATION=7200
INTRON_LANGUAGES=en-NG,pcm,yo,ig,ha
INTRON_INITIAL_POLL_DELAY=5
INTRON_POLL_INTERVAL=15
INTRON_POLL_TIMEOUT_MINUTES=60
INTRON_DOWNLOAD_TIMEOUT=300
INTRON_UPLOAD_TIMEOUT=300

# Billing placeholders. Set provider prices before accepting paid transcriptions.
DEEPGRAM_MODEL=nova-2
BILLING_FREE_CREDITS=0
BILLING_DEEPGRAM_CREDITS_PER_MINUTE=3
BILLING_INTRON_CREDITS_PER_MINUTE=5
# Optional provider costs in USD/minute for internal cost reporting.
BILLING_DEEPGRAM_USD_PER_MINUTE=0.006
BILLING_INTRON_USD_PER_MINUTE=0.007
# Manual NGN per USD quote; refresh its timestamp when updating the rate.
BILLING_NGN_PER_USD=1340
BILLING_FX_UPDATED_AT=

PAYSTACK_USD_ENABLED=false
# Install ffprobe on the ingestion worker, or set an absolute executable path.
FFPROBE_BIN=ffprobe

FLUTTERWAVE_USD_ENABLED=false

PAYSTACK_ENABLED=true
FLUTTERWAVE_ENABLED=true
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CALLBACK_URL=http://localhost:3000/payment/callback?provider=flutterwave
FLW_ENCRYPTION_KEY=
FLW_ENV='staging/production'
FLW_LOG_DIR=logs


PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback?provider=paystack

GOOGLE_TRANSLATION_API_KEY=
BILLING_GOOGLE_TRANSLATION_CREDITS_PER_1000_CHARACTERS=
# Optional internal cost reporting in USD per 1,000 characters.
BILLING_GOOGLE_TRANSLATION_USD_PER_1000_CHARACTERS=

ELEVENLABS_API_KEY=
BILLING_ELEVENLABS_DUBBING_CREDITS_PER_MINUTE=
BILLING_ELEVENLABS_DUBBING_USD_PER_MINUTE=
FFMPEG_BIN=ffmpeg

# Additional transcription providers
# Example routing: {"yo":"elevenlabs","ha":"google"}
TRANSCRIBER_LANGUAGE_PROVIDERS='{}'
GOOGLE_SPEECH_PROJECT_ID=
GOOGLE_SPEECH_LOCATION=us
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPEECH_BUCKET=
GOOGLE_SPEECH_MODEL=chirp_3
GOOGLE_SPEECH_DIARIZATION=true
GOOGLE_SPEECH_WORD_TIMESTAMPS=true
BILLING_GOOGLE_TRANSCRIPTION_CREDITS_PER_MINUTE=
BILLING_GOOGLE_TRANSCRIPTION_USD_PER_MINUTE=
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2
ELEVENLABS_TRANSCRIPTION_WEBHOOK_ID=
ELEVENLABS_TRANSCRIPTION_WEBHOOK_SECRET=
ELEVENLABS_TRANSCRIPTION_DIARIZATION=true
BILLING_ELEVENLABS_TRANSCRIPTION_CREDITS_PER_MINUTE=
BILLING_ELEVENLABS_TRANSCRIPTION_USD_PER_MINUTE=
# Configurable dubbing provider: elevenlabs or heygen
DUBBING_PROVIDER=elevenlabs
HEYGEN_API_KEY=
HEYGEN_DUBBING_MODE=precision
HEYGEN_DUBBING_SPEAKERS=
HEYGEN_DUBBING_DISABLE_MUSIC=false
HEYGEN_DUBBING_ENHANCE_SPEECH=false
HEYGEN_DOWNLOAD_HOSTS=resource.heygen.ai,resource2.heygen.ai,files.heygen.ai
BILLING_HEYGEN_PRECISION_CREDITS_PER_MINUTE=
BILLING_HEYGEN_PRECISION_USD_PER_MINUTE=
BILLING_HEYGEN_SPEED_CREDITS_PER_MINUTE=
BILLING_HEYGEN_SPEED_USD_PER_MINUTE=
# Subtitle rendering runs on the subtitle_rendering connection / subtitle-rendering queue.
# Install FFmpeg with libass and Noto fonts on the rendering worker.
DUBBING_SUBTITLE_FONT="Noto Sans"
DUBBING_SUBTITLE_FONTS_DIRECTORY=
DUBBING_SUBTITLE_THREADS=2
# Subtitles-only video pricing includes transcription, translation and rendering.
BILLING_SUBTITLES_CREDITS_PER_MINUTE=
BILLING_SUBTITLES_USD_PER_MINUTE=

# Audio dubbing uses its own provider setting and the existing dubbing credit rate.
DUBBING_AUDIO_PROVIDER=elevenlabs

# OpenAI: select with TRANSCRIBER_FALLBACK=openai or TRANSLATION_PROVIDER=openai.
# Configure positive credit prices before enabling each activity; provider cost fields are optional estimates.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSCRIPTION_MAX_MINUTES=90
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
TRANSLATION_PROVIDER=google
BILLING_OPENAI_TRANSCRIPTION_CREDITS_PER_MINUTE=
BILLING_OPENAI_TRANSCRIPTION_USD_PER_MINUTE=
BILLING_OPENAI_TRANSLATION_CREDITS_PER_1000_CHARACTERS=
BILLING_OPENAI_TRANSLATION_USD_PER_1000_CHARACTERS=
BILLING_OPENAI_CLEANUP_CREDITS_PER_1000_CHARACTERS=
BILLING_OPENAI_CLEANUP_USD_PER_1000_CHARACTERS=
BILLING_OPENAI_SUMMARY_CREDITS_PER_1000_CHARACTERS=
BILLING_OPENAI_SUMMARY_USD_PER_1000_CHARACTERS=
