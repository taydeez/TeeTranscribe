APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=teetranscribe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_QUEUE_RETRY_AFTER=960

CACHE_STORE=redis
RATE_LIMITER_STORE=redis

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://127.0.0.1:3000
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TRANSCRIBER_FALLBACK=deepgram
INTRON_API_KEY=
INTRON_API_ENDPOINT=https://infer.voice.intron.io
INTRON_DIARIZATION=true
INTRON_DIARIZATION_MIN_DURATION=7200
INTRON_LANGUAGES=en-NG,pcm,yo,ig,ha
INTRON_INITIAL_POLL_DELAY=5
INTRON_POLL_INTERVAL=15
INTRON_POLL_TIMEOUT_MINUTES=60
INTRON_DOWNLOAD_TIMEOUT=300
INTRON_UPLOAD_TIMEOUT=300

# Billing placeholders. Set provider prices before accepting paid transcriptions.
DEEPGRAM_MODEL=nova-2
BILLING_FREE_CREDITS=0
BILLING_DEEPGRAM_CREDITS_PER_MINUTE=3
BILLING_INTRON_CREDITS_PER_MINUTE=5
# Optional provider costs in USD/minute for internal cost reporting.
BILLING_DEEPGRAM_USD_PER_MINUTE=0.006
BILLING_INTRON_USD_PER_MINUTE=0.007
# Manual NGN per USD quote; refresh its timestamp when updating the rate.
BILLING_NGN_PER_USD=1340
BILLING_FX_UPDATED_AT=

PAYSTACK_USD_ENABLED=false
# Install ffprobe on the ingestion worker, or set an absolute executable path.
FFPROBE_BIN=ffprobe

FLUTTERWAVE_USD_ENABLED=false

PAYSTACK_ENABLED=true
FLUTTERWAVE_ENABLED=true
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CALLBACK_URL=http://localhost:3000/payment/callback?provider=flutterwave
FLW_ENCRYPTION_KEY=
FLW_ENV='staging/production'
FLW_LOG_DIR=logs


PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback?provider=paystack
